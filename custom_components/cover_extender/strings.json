{
  "config": {
    "step": {
      "user": {
        "title": "Cover Extender"
      }
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]"
    }
  },
  "config_subentries": {
    "facade": {
      "initiate_flow": {
        "user": "Add facade"
      },
      "entry_type": "Facade",
      "step": {
        "user": {
          "title": "Add facade",
          "data": {
            "name":    "Name",
            "azimuth": "Azimuth (°)"
          },
          "data_description": {
            "name":    "Unique name for this facade (e.g. South, West).",
            "azimuth": "Compass bearing of the facade in degrees (0 = North, 180 = South)."
          }
        },
        "reconfigure": {
          "title": "Edit facade",
          "data": {
            "name":    "Name",
            "azimuth": "Azimuth (°)"
          }
        }
      },
      "error": {
        "name_required":     "Name is required.",
        "facade_name_exists": "A facade with this name already exists."
      },
      "abort": {
        "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]",
        "already_configured": "[%key:common::config_flow::abort::already_configured_service%]"
      }
    },
    "mode": {
      "initiate_flow": {
        "user": "Add mode"
      },
      "entry_type": "Mode",
      "step": {
        "user": {
          "title": "Add mode",
          "data": {
            "name":     "Name",
            "icon":     "Icon (MDI)",
            "color":    "Color (hex #RRGGBB)",
            "lock":     "Lock covers in this mode",
            "behavior": "Automation behavior",
            "hidden":   "Hide from global mode selector"
          },
          "sections": {
            "advanced_section": {
              "name": "Advanced",
              "data": {
                "hidden": "Hide from global mode selector"
              }
            }
          }
        },
        "reconfigure": {
          "title": "Edit mode",
          "data": {
            "name":        "Name",
            "icon":        "Icon (MDI)",
            "color":       "Color (hex #RRGGBB)",
            "lock":        "Lock covers in this mode",
            "behavior":    "Automation behavior",
            "hidden":      "Hide from global mode selector",
            "delete_mode": "Delete this mode"
          },
          "sections": {
            "advanced_section": {
              "name": "Advanced",
              "data": {
                "hidden":      "Hide from global mode selector",
                "delete_mode": "Delete this mode"
              }
            }
          }
        },
        "confirm_delete": {
          "title": "Confirm deletion",
          "description": "Mode **{mode}** is used by {count} cover(s): {covers}.\n\nDeleting it will remove it from all those covers. This action cannot be undone."
        }
      },
      "error": {
        "name_required":    "Name is required.",
        "mode_name_exists": "A mode with this name already exists."
      },
      "abort": {
        "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]",
        "mode_deleted": "Mode deleted and removed from all covers."
      }
    },
    "cover_template": {
      "initiate_flow": {
        "user": "Add cover template"
      },
      "entry_type": "Cover template",
      "step": {
        "user": {
          "title": "Cover template — identity",
          "data": {
            "name":        "Name",
            "angle_left":  "Left angle (°)",
            "angle_right": "Right angle (°)"
          },
          "data_description": {
            "name":        "Unique name for this template (e.g. Standard window, Bay window).",
            "angle_left":  "Sun azimuth offset to the left of the facade normal (0–90°).",
            "angle_right": "Sun azimuth offset to the right of the facade normal (0–90°)."
          }
        },
        "reconfigure": {
          "title": "Cover template — identity",
          "data": {
            "name":        "Name",
            "angle_left":  "Left angle (°)",
            "angle_right": "Right angle (°)"
          }
        },
        "template_automation": {
          "title": "Cover template — automation",
          "sections": {
            "shade": {
              "name": "Autonomous shade",
              "data": {
                "shade_enable":           "Enable autonomous shade",
                "shade_distance":         "Obstacle distance (m)",
                "shade_max_height":       "Maximum shade height (m)",
                "shade_min_height":       "Minimum shade height (m)",
                "shade_degrees":          "Window width (°)",
                "shade_max_elevation":    "Max sun elevation (°)",
                "shade_min_elevation":    "Min sun elevation (°)",
                "shade_minimum_position": "Minimum position (%)",
                "shade_default_position": "Default position (%)",
                "shade_change_threshold": "Change threshold (%)",
                "shade_time_out":         "Stability timeout (min)"
              }
            },
            "solar_gain": {
              "name": "Solar gain optimisation",
              "data": {
                "solar_gain_enable":         "Enable solar gain optimisation",
                "solar_gain_position_cold":  "Cold position (%)",
                "solar_gain_position_solar": "Solar position (%)"
              }
            }
          }
        }
      },
      "error": {
        "name_required":        "Name is required.",
        "template_name_exists": "A template with this name already exists."
      },
      "abort": {
        "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
      }
